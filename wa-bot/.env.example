# === Koneksi ke API e-TA (server Node) ===
# URL REST API e-TA yang sudah berjalan (npm start / node server.js).
E_TA_API_BASE=http://localhost:3001

# === Session WhatsApp ===
# Path file SQLite tempat session WhatsApp disimpan.
WA_DB=wa_session.db

# === Mode login pertama ===
# Kosongkan = login via QR code di terminal.
# Isi nomor HP (awali +62) untuk login pakai pairing code tanpa QR.
WA_PAIR_PHONE=

# === Pembatasan chat (opsional, disarankan) ===
# Daftar JID chat yang boleh memakai bot, dipisah koma.
# Contoh: 6281234567890@s.whatsapp.net,12036304xxxxxxxx@g.us
# Kosong = semua chat (individu & grup) bisa memakai bot.
WA_ALLOWED_CHATS=

# === Level log whatsmeow ===
# DEBUG | INFO | WARN | ERROR
WA_LOG=WARN
