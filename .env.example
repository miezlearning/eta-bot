# === Kredensial e-TA ===
E_TA_USERID=your_nim
E_TA_PASSWORD=your_password
E_TA_ROLE=Mahasiswa

# === Server API ===
API_PORT=3001
BASE_URL=https://e-office.ft.unmul.ac.id
HTTP_TIMEOUT=15000

# === Notifikasi Telegram (opsional) ===
# Untuk mengaktifkan, isi token bot + chat/group ID. Biarkan kosong untuk menonaktifkan.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Interval pengecekan perubahan jadwal sidang (ms). Default 900000 = 15 menit.
NOTIFY_INTERVAL_MS=900000

# === Bot Telegram di Vercel (webhook) ===
# Token bot (sama dengan di atas). Secret untuk verifikasi webhook — buat string acak.
TELEGRAM_WEBHOOK_SECRET=