# === Kredensial e-TA ===
E_TA_USERID=your_nim
E_TA_PASSWORD=your_password
E_TA_ROLE=Mahasiswa

# === Server API ===
API_PORT=3001
BASE_URL=https://e-office.ft.unmul.ac.id
HTTP_TIMEOUT=15000

# === Bot Telegram ===
# Token dari @BotFather
TELEGRAM_BOT_TOKEN=
# Mode polling: 'true' (default di VPS/Coolify, langsung jalan tanpa domain/SSL).
# Set 'false' bila menggunakan mode webhook murni di /api/webhook.
TELEGRAM_POLLING=true
# Secret untuk verifikasi webhook (hanya jika TELEGRAM_POLLING=false atau di Vercel).
TELEGRAM_WEBHOOK_SECRET=

# === Notifikasi Jadwal Telegram (opsional) ===
# ID chat/group tujuan notifikasi berkala saat jadwal sidang berubah.
TELEGRAM_CHAT_ID=
# Interval pengecekan perubahan jadwal sidang (ms). Default 900000 = 15 menit.
NOTIFY_INTERVAL_MS=900000

# === Bot WhatsApp (opsional, jika menjalankan wa-bot) ===
# Nomor HP untuk pairing code (+628xxxx) tanpa scan QR
WA_PAIR_PHONE=
# Filter chat/grup yang diizinkan (kosong = semua)
WA_ALLOWED_CHATS=
WA_LOG=WARN
